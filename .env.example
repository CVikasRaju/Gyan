# --- FRONTEND (Next.js) ---
# Supabase Public Keys (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- BACKEND & PIPELINE ---
# Supabase Private Keys (SERVER ONLY - DO NOT COMMIT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_CONNECTION_STRING=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# AI Models
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# n8n Configuration
N8N_ENCRYPTION_KEY=your-random-encryption-key
N8N_WEBHOOK_SECRET=your-long-random-webhook-secret
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# News APIs
NEWSDATA_API_KEY=
NEWSAPI_AI_API_KEY=
START_SOURCE_RANK_PERCENTILE=80

# Fact checking
ORIGINALITY_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_FACT_CHECK_MODEL=bespoke-minicheck

# Monitoring
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Scraper Configuration
SCRAPER_PORT=8000
